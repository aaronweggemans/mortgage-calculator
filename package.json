{
  "name": "mortgage-calculator",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration production --output-hashing none",
    "build:web-component": "npm run build:production && vite build --config vite.config.mts",
    "build:wordpress-plugin": "npm run build:web-component && zip-a-folder ./wp-mortgage-calculator ./wp-mortgage-calculator.zip",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.*": "prettier --write"
  },
  "engines": {
    "node": "24",
    "npm": "11"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/elements": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@angular/router": "^22.1.4",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@eslint/js": "^10.0.1",
    "@ngneat/spectator": "^22.1.0",
    "@testing-library/dom": "^10.4.1",
    "@types/postcss-prefix-selector": "^1.16.3",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.2.0",
    "bootstrap": "^5.3.8",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "ng-mocks": "^14.17.3",
    "postcss-prefix-selector": "^2.2.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11",
    "zip-a-folder": "^7.0.0"
  }
}
